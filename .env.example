# Wazuh version — must match the running manager
WAZUH_VERSION=4.14.5

# Manager connection
WAZUH_MANAGER=wazuh-manager
WAZUH_MANAGER_PORT=1514
WAZUH_PROTOCOL=tcp

# Enrollment (defaults to WAZUH_MANAGER / 1515 if unset)
# WAZUH_REGISTRATION_SERVER=
# WAZUH_REGISTRATION_PORT=1515
# WAZUH_REGISTRATION_PASSWORD=

# Agent identity
# WAZUH_AGENT_NAME=syslog-forwarder   (set per instance)
# WAZUH_AGENT_GROUP=                  (comma-separated group names)

# Connection tuning
# WAZUH_KEEP_ALIVE_INTERVAL=10
# WAZUH_TIME_RECONNECT=60

# SSL — paths inside the container; mount cert files via a volume
# WAZUH_REGISTRATION_CA=
# WAZUH_REGISTRATION_CERTIFICATE=
# WAZUH_REGISTRATION_KEY=
